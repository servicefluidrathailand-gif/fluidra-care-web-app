# ============================================
# Fluidra Care - Production Environment
# ============================================

# Node.js Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=fluidra_prod_user
DB_PASSWORD=Secure@Pass123!
DB_NAME=fluidra_care_prod

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=fluidra_secret_key_2024_min_32_chars_abcdefghijklmnopqrstuvwxyz

# ============================================
# LINE OA INTEGRATION
# ============================================
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_OA_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_LINE_OA_SECRET_HERE

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://fluidra-care.your-domain.com

# ============================================
# EMAIL SERVICE (Gmail)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SEND_FROM_EMAIL=noreply@fluidra-care.com

# ============================================
# REDIS CACHE
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://fluidra-care.your-domain.com
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# ============================================
# TIMEZONE
# ============================================
TZ=Asia/Bangkok

